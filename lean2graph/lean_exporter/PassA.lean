import Lean
import Lean.Util.CollectAxioms

open Lean Elab

def jsonString (value : String) : Json := Json.str value

def positionJson (pos : Position) : Json :=
  Json.mkObj [
    ("line", pos.line),
    ("column", pos.column),
  ]

def rangeJson (ranges : DeclarationRanges) : Json :=
  Json.mkObj [
    ("range", Json.mkObj [
      ("start", positionJson ranges.range.pos),
      ("end", positionJson ranges.range.endPos),
    ]),
    ("selection", Json.mkObj [
      ("start", positionJson ranges.selectionRange.pos),
      ("end", positionJson ranges.selectionRange.endPos),
    ]),
  ]

def sourceRangeJson (ranges : DeclarationRanges) : Json :=
  Json.mkObj [
    ("start", positionJson ranges.range.pos),
    ("end", positionJson ranges.range.endPos),
  ]

def selectionRangeJson (ranges : DeclarationRanges) : Json :=
  Json.mkObj [
    ("start", positionJson ranges.selectionRange.pos),
    ("end", positionJson ranges.selectionRange.endPos),
  ]

def constantKind (env : Environment) (name : Name) (ci : ConstantInfo) : String :=
  if Lean.isClass env name then
    "class"
  else if Lean.isStructure env name then
    "structure"
  else if Lean.Meta.isInstanceCore env name then
    "instance"
  else
  match ci with
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "def"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quot"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

def ppOptions : Options :=
  ({} : Options)
    |>.setBool `pp.explicit false
    |>.setBool `pp.universes false

def exprPretty (env : Environment) (expr : Expr) : IO String := do
  let format ← Lean.PrettyPrinter.ppExprLegacy env {} {} ppOptions expr
  pure format.pretty

def rawExpr (expr : Expr) : String :=
  s!"{repr expr}"

def rawExprId (projectId declName kind : String) (expr : Expr) : String :=
  s!"expr:{projectId}:{declName}:{kind}:{hash (rawExpr expr)}"

def binderInfoName : BinderInfo → String
  | .default => "explicit"
  | .implicit => "implicit"
  | .strictImplicit => "strict_implicit"
  | .instImplicit => "instance_implicit"

def statementContextJson (ctx : ContextInfo) (projectId declName : String)
    (type : Expr) : IO Json := do
  ctx.runMetaM {} do
    Lean.Meta.forallTelescope type fun fvars target => do
      let lctx : LocalContext ← getLCtx
      let mut variables : Array Json := #[]
      let mut assumptions : Array Json := #[]
      for fvar in fvars do
        let localDecl := lctx.getFVar! fvar
        let typePretty ← Lean.Meta.ppExpr localDecl.type
        let isAssumption ← Lean.Meta.isProp localDecl.type
        let (fvarId, userName, binderInfo) :=
          match localDecl with
          | .cdecl _ fvarId userName _ binderInfo _ =>
              (fvarId, userName, binderInfo)
          | .ldecl _ fvarId userName _ _ _ _ =>
              (fvarId, userName, BinderInfo.default)
        let declaration := Json.mkObj [
          ("fvar_id", fvarId.name.toString),
          ("name", userName.toString),
          ("type_pretty", typePretty.pretty),
          ("type_expr_id", rawExprId projectId declName "statement-local-type" localDecl.type),
          ("type_expr_raw", rawExpr localDecl.type),
          ("binder_info", binderInfoName binderInfo),
          ("inaccessible_name", Json.bool (userName.isAnonymous || userName.toString.contains '✝')),
        ]
        if isAssumption then
          assumptions := assumptions.push declaration
        else
          variables := variables.push declaration
      let goalPretty ← Lean.Meta.ppExpr target
      pure <| Json.mkObj [
        ("variables", Json.arr variables),
        ("assumptions", Json.arr assumptions),
        ("goal_pretty", goalPretty.pretty),
        ("goal_expr_id", rawExprId projectId declName "statement-goal" target),
        ("goal_expr_raw", rawExpr target),
      ]

structure RefMetadata where
  kind : String
  isInstance : Bool
  isClass : Bool
  isProjection : Bool
  isAutoGenerated : Bool
  module : Option String
  statementPretty : String
  docstring : Option String
  typeExprId : String
  typeExprRaw : String
  deriving Inhabited

def getRefMetadata (env : Environment) (projectId : String) (name : Name)
    (isExternal : Bool) : IO RefMetadata := do
  match env.find? name with
  | none => pure {
      kind := "unknown"
      isInstance := false
      isClass := false
      isProjection := false
      isAutoGenerated := false
      module := none
      statementPretty := ""
      docstring := none
      typeExprId := s!"expr:external:{name}:type"
      typeExprRaw := ""
    }
  | some ci =>
    let statementPretty ← exprPretty env ci.type
    let docstring ← Lean.findDocString? env name
    let module := (env.header.moduleNames[·]!) <$> env.getModuleIdxFor? name
    let isPrivate := isPrivateName name
    pure {
      kind := constantKind env name ci
      isInstance := Lean.Meta.isInstanceCore env name
      isClass := Lean.isClass env name
      isProjection := env.isProjectionFn name
      isAutoGenerated := name.isInternal || isPrivate || Lean.isAuxRecursor env name
      module := module.map toString
      statementPretty
      docstring
      typeExprId := if isExternal then s!"expr:external:{name}:type" else s!"expr:{projectId}:{name}:type"
      typeExprRaw := s!"{repr ci.type}"
    }

partial def collectRefs (expr : Expr) (origin : String) (usageKind : String)
    (result : Array (Name × String × String)) : Array (Name × String × String) :=
  match expr with
  | .const name _ =>
      result.push (name, origin, usageKind)
  | .app fn arg =>
      let result := collectRefs fn origin "applied_head" result
      collectRefs arg origin "argument" result
  | .lam _ binding body _ =>
      let result := collectRefs binding origin "type_level" result
      collectRefs body origin usageKind result
  | .forallE _ binding body _ =>
      let result := collectRefs binding origin "type_level" result
      collectRefs body origin "type_level" result
  | .letE _ type value body _ =>
      let result := collectRefs type origin "type_level" result
      let result := collectRefs value origin "argument" result
      collectRefs body origin usageKind result
  | .mdata _ expr => collectRefs expr origin usageKind result
  | .proj _ _ expr => collectRefs expr origin "argument" result
  | _ => result

unsafe def main (args : List String) : IO Unit := do
  let projectId :: moduleName :: fileName :: _ := args
    | throw <| IO.userError "usage: PassA project_id module_name file.lean"

  Lean.initSearchPath (← Lean.findSysroot)
  Lean.enableInitializersExecution
  let input ← IO.FS.readFile fileName
  let inputCtx := Parser.mkInputContext input fileName
  let (header, parserState, headerMessages) ← Parser.parseHeader inputCtx
  let (beforeEnv, headerMessages) ← Elab.processHeader header {} headerMessages inputCtx
  let initialState := { Command.mkState beforeEnv headerMessages {} with infoState.enabled := true }
  let frontendState ← IO.processCommands inputCtx parserState initialState
  let commandState := frontendState.commandState

  for message in commandState.messages.toList do
    let text ← message.toString
    if message.severity == MessageSeverity.error then
      IO.println <| Json.mkObj [
        ("schema_version", "2"),
        ("record", "error"),
        ("project_id", projectId),
        ("module", moduleName),
        ("message", text),
      ] |>.compress

  let env := commandState.env
  let declarationContexts ← IO.mkRef ({} : Std.HashMap Name ContextInfo)
  for tree in commandState.infoState.trees do
    tree.visitM'
      (preNode := fun _ _ _ => pure true)
      (postNode := fun ctx _ _ => do
        if let some declName := ctx.parentDecl? then
          declarationContexts.modify fun contexts =>
            if contexts.contains declName then contexts
            else contexts.insert declName ctx
        pure ())
  let declarationContexts ← declarationContexts.get
  let mut refMetadataCache : Std.HashMap Name RefMetadata := {}
  for pair in env.constants.toList do
    let name := pair.1
    if beforeEnv.constants.find? name |>.isSome then
      continue
    if let some ci := env.find? name then
      let kind := constantKind env name ci
      let typeRefs := collectRefs ci.type "type" "type_level" #[]
      let valueRefs :=
        match ci.value? (allowOpaque := true) with
        | some value =>
          let origin := if kind == "def" || kind == "instance" || kind == "opaque" then "body" else "proof"
          collectRefs value origin "applied_head" #[]
        | none => #[]
      let mut refsJson : Array Json := #[]
      for (usedName, origin, usageKind) in typeRefs ++ valueRefs do
        let metadata ← match refMetadataCache.get? usedName with
          | some metadata => pure metadata
          | none =>
            let metadata ← getRefMetadata env projectId usedName (beforeEnv.constants.find? usedName |>.isSome)
            refMetadataCache := refMetadataCache.insert usedName metadata
            pure metadata
        refsJson := refsJson.push <| Json.mkObj [
          ("const_name", usedName.toString),
          ("origin", origin),
          ("usage_kind", usageKind),
          ("count", 1),
          ("kind", metadata.kind),
          ("is_instance", Json.bool metadata.isInstance),
          ("is_class", Json.bool metadata.isClass),
          ("is_projection", Json.bool metadata.isProjection),
          ("is_auto_generated", Json.bool metadata.isAutoGenerated),
          ("module", metadata.module.map Json.str |>.getD Json.null),
          ("statement_pretty", metadata.statementPretty),
          ("type_expr_id", metadata.typeExprId),
          ("type_expr_raw", metadata.typeExprRaw),
          ("docstring", metadata.docstring.map Json.str |>.getD Json.null),
        ]
      let mut axiomNames : Array Name := #[]
      let typeNames := ci.type.getUsedConstants
      let valueNames :=
        match ci.value? (allowOpaque := true) with
        | some value => value.getUsedConstants
        | none => #[]
      for usedName in typeNames ++ valueNames do
        if let some usedInfo := env.find? usedName then
          match usedInfo with
          | .axiomInfo _ =>
              if !axiomNames.contains usedName then
                axiomNames := axiomNames.push usedName
          | _ => pure ()
      let typePretty ← exprPretty env ci.type
      let typeExprId := s!"expr:{projectId}:{name}:type"
      let statementContext ←
        match declarationContexts.get? name with
        | some ctx => statementContextJson ctx projectId name.toString ci.type
        | none => pure Json.null
      let valuePretty ← match ci.value? (allowOpaque := true) with
        | some value => do
          let text ← exprPretty env value
          pure (Json.str text)
        | none => pure Json.null
      let docstring ← Lean.findDocString? env name
      let declarationRanges? ← Lean.Core.CoreM.toIO' (findDeclarationRanges? name) {
        fileName := fileName
        fileMap := inputCtx.fileMap
      } { env := env }
      let finalComponent := (name.toString.splitOn ".").getLast!
      let isMatcher := Lean.Meta.isMatcherCore env name
      let isEquation := Lean.Meta.isEqnReservedNameSuffix finalComponent
        || finalComponent == "eq_def"
        || finalComponent == "eq_unfold"
      let isPrivate := isPrivateName name
      let isAuxiliary := name.isInternal || isMatcher || Lean.isAuxRecursor env name || isEquation
      let fields : List (String × Json) := [
        ("schema_version", toJson (2 : Nat)),
        ("record", "declaration"),
        ("project_id", projectId),
        ("module", moduleName),
        ("name", name.toString),
        ("kind", kind),
        ("is_instance", Json.bool (Lean.Meta.isInstanceCore env name)),
        ("is_class", Json.bool (Lean.isClass env name)),
        ("is_projection", Json.bool (env.isProjectionFn name)),
        ("is_auto_generated", Json.bool (name.isInternal || isPrivate || isAuxiliary)),
        ("is_matcher", Json.bool isMatcher),
        ("is_auxiliary", Json.bool isAuxiliary),
        ("is_private", Json.bool isPrivate),
        ("is_unsafe", Json.bool ci.isUnsafe),
        ("is_partial", Json.bool ci.isPartial),
        ("type_pretty", typePretty),
        ("type_expr_id", typeExprId),
        ("type_expr_raw", rawExpr ci.type),
        ("statement_context", statementContext),
        ("value_pretty", valuePretty),
        ("range", declarationRanges?.map sourceRangeJson |>.getD Json.null),
        ("name_range", declarationRanges?.map selectionRangeJson |>.getD Json.null),
        ("range_origin", if declarationRanges?.isSome then "lean" else "none"),
        ("docstring", docstring.map Json.str |>.getD Json.null),
        ("axioms", Json.arr (axiomNames.map (fun axiomName => Json.str axiomName.toString))),
        ("const_refs", Json.arr refsJson),
        ("truncated", Json.bool false),
      ]
      IO.println <| Json.mkObj fields |>.compress
